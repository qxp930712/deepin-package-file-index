#!/bin/sh
set -e

case "$1" in
    configure)
        if [ ! -f /var/cache/deepin/package-file-index/installed.idx ]; then
            deepin-pkgfile-index-build || true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
esac
